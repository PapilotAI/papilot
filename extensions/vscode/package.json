{
  "name": "papilot",
  "displayName": "Papilot",
  "description": "Papilot's paper workspace, PDF review and LaTeX source navigation in VS Code.",
  "version": "0.1.0",
  "publisher": "papilot",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/PapilotAI/papilot.git" },
  "engines": { "vscode": "^1.119.0" },
  "categories": ["Other"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.cjs",
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "contributes": {
    "commands": [
      { "command": "papilot.open", "title": "Open Papilot", "category": "Papilot" },
      { "command": "papilot.openWorkspace", "title": "Open Workspace Paper", "category": "Papilot" },
      { "command": "papilot.showPdf", "title": "Show Selection in Paper", "category": "Papilot" }
    ],
    "menus": { "editor/context": [{ "command": "papilot.showPdf", "when": "resourceExtname == .tex", "group": "navigation" }] }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "test:vscode": "npm run build && node scripts/test-vscode.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.119.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.2",
    "tar": "^7.5.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
