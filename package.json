{
  "name": "papilot",
  "version": "0.5.0",
  "description": "A Cursor-like workspace for your papers: annotate and review PDFs directly without ever touching LaTeX.",
  "keywords": [
    "latex",
    "pdf",
    "diff",
    "review",
    "ai",
    "agent",
    "codex",
    "claude",
    "antigravity",
    "writing",
    "academic",
    "manuscript"
  ],
  "homepage": "https://github.com/cu1ch3n/papilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cu1ch3n/papilot.git"
  },
  "bugs": {
    "url": "https://github.com/cu1ch3n/papilot/issues"
  },
  "license": "MIT",
  "author": "Cui Chen",
  "type": "module",
  "bin": {
    "papilot": "bin/papilot.mjs"
  },
  "files": [
    "bin",
    "src/server",
    "src/shared.ts",
    "src/notes.ts",
    "src/conversation.ts",
    "src/commit.ts",
    "skills",
    "dist",
    "scripts/demo.ts",
    "scripts/service.ts",
    "examples/papilot-paper",
    "vendor/latex-review/src",
    "vendor/latex-review/dist",
    "vendor/latex-review/package.json",
    "vendor/latex-review/package-lock.json",
    "vendor/latex-review/LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup:review": "npm --prefix vendor/latex-review ci && npm --prefix vendor/latex-review run build",
    "demo": "tsx scripts/demo.ts",
    "doctor": "node bin/papilot.mjs doctor",
    "service:install": "tsx scripts/service.ts install",
    "service:stop": "tsx scripts/service.ts stop",
    "test:ui": "npm run build && node scripts/check-ui.mjs && node scripts/check-review-notes.mjs && node --import tsx scripts/check-review-flow.mjs && node scripts/check-skills.mjs && node --import tsx scripts/check-accounts.mjs",
    "site": "node scripts/build-site.mjs",
    "site:video": "node scripts/build-site.mjs --video",
    "prepack": "npm run build && npm run setup:review"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/static": "^10.1.7",
    "@simplewebauthn/server": "^14.0.3",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "mupdf": "^1.28.1",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@openai/codex": "0.164.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "katex": "^0.16.47",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
